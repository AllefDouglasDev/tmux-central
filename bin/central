#!/usr/bin/env bash
# central — tmux-central CLI. Resolves symlinks up to the project root and
# runs src/cli.ts directly (Node ≥ 23.6 runs TypeScript without a build).
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$dir/$src"
done
root="$(cd -P "$(dirname "$src")/.." && pwd)"

# Pinned Node: a project's .tool-versions with an old Node must not break the central.
node="${CENTRAL_NODE:-}"
if [ -z "$node" ]; then
  for candidate in /opt/homebrew/bin/node /usr/local/bin/node "$(command -v node 2>/dev/null)"; do
    [ -x "$candidate" ] && { node="$candidate"; break; }
  done
fi
[ -n "$node" ] || { echo "✗ node not found (set CENTRAL_NODE)" >&2; exit 1; }

exec "$node" --disable-warning=ExperimentalWarning "$root/src/cli.ts" "$@"
