#!/usr/bin/env bash
# central — CLI do tmux-central. Resolve symlinks até a raiz do projeto e
# roda o src/cli.ts direto (Node ≥ 23.6 executa TypeScript sem build).
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$dir/$src"
done
root="$(cd -P "$(dirname "$src")/.." && pwd)"

# Node fixo: um .tool-versions de projeto com Node antigo não pode quebrar a central.
node="${CENTRAL_NODE:-}"
if [ -z "$node" ]; then
  for candidate in /opt/homebrew/bin/node /usr/local/bin/node "$(command -v node 2>/dev/null)"; do
    [ -x "$candidate" ] && { node="$candidate"; break; }
  done
fi
[ -n "$node" ] || { echo "✗ node não encontrado (defina CENTRAL_NODE)" >&2; exit 1; }

exec "$node" --disable-warning=ExperimentalWarning "$root/src/cli.ts" "$@"
