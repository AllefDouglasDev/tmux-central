{
  "name": "tmux-central",
  "version": "0.1.0",
  "description": "MCP server + CLI to orchestrate LLM subagents as tmux windows",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "central": "bin/central"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "central": "node src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
